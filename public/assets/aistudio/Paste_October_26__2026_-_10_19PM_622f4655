{
  "title": "LEPS Live Shopping Simulator",
  "description": "Simulador interactivo y responsivo de Live Shopping 9:16 (Dark Tech Minimalist) empaquetado como documento HTML5 autocontenido.",
  "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n  <title>LEPS Live Shopping Simulator</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --bg-black: #000000;\n      --bg-surface: #121216;\n      --bg-surface-trans: rgba(18, 18, 22, 0.75);\n      --bg-card: rgba(22, 22, 28, 0.85);\n      --neon-magenta: #E51EE2;\n      --neon-cyan: #0693E3;\n      --neon-magenta-glow: rgba(229, 30, 226, 0.45);\n      --neon-cyan-glow: rgba(6, 147, 227, 0.45);\n      --text-main: #FFFFFF;\n      --text-muted: #A0A0A0;\n      --danger: #FF3B30;\n      --success: #00E676;\n      --border-color: rgba(255, 255, 255, 0.12);\n      --border-neon: rgba(229, 30, 226, 0.35);\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      -webkit-tap-highlight-color: transparent;\n      user-select: none;\n    }\n\n    body {\n      background: radial-gradient(circle at 50% 20%, #1a1226 0%, #07070a 60%, #000000 100%);\n      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n      color: var(--text-main);\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow-x: hidden;\n      padding: 10px;\n    }\n\n    /* Contenedor Mockup Smartphone */\n    .device-wrapper {\n      position: relative;\n      width: 100%;\n      max-width: 420px;\n      height: 860px;\n      max-height: 94vh;\n      background: #000000;\n      border-radius: 46px;\n      box-shadow: 0 0 0 10px #1a1a20, 0 0 0 12px #2d2d38, 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 35px var(--neon-cyan-glow);\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    @media (max-width: 480px) {\n      body {\n        padding: 0;\n        background: #000;\n      }\n      .device-wrapper {\n        max-width: 100%;\n        height: 100vh;\n        max-height: 100vh;\n        border-radius: 0;\n        box-shadow: none;\n        border: none;\n      }\n    }\n\n    /* Notch / Isla Dinámica */\n    .device-notch {\n      position: absolute;\n      top: 10px;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 110px;\n      height: 25px;\n      background: #000;\n      border-radius: 20px;\n      z-index: 50;\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n    }\n    .device-camera {\n      width: 9px;\n      height: 9px;\n      background: #0f172a;\n      border-radius: 50%;\n      border: 1px solid #334155;\n    }\n\n    /* Video Background Stage */\n    .video-viewport {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 1;\n      overflow: hidden;\n      background: #08080c;\n    }\n\n    .video-stream {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      transform: scale(1.02);\n    }\n\n    .video-overlay-gradient {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(180deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 25%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.85) 85%, #000000 100%);\n      pointer-events: none;\n      z-index: 2;\n    }\n\n    /* Canvas simulado en caso de fallo de red de video */\n    #fallbackCanvas {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 1;\n      display: none;\n    }\n\n    /* UI Overlays */\n    .ui-layer {\n      position: relative;\n      z-index: 10;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 42px 14px 16px;\n      pointer-events: none;\n    }\n    .ui-interactive {\n      pointer-events: auto;\n    }\n\n    /* Header */\n    .stream-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 8px;\n      width: 100%;\n    }\n\n    .channel-info {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: rgba(18, 18, 22, 0.7);\n      backdrop-filter: blur(12px);\n      padding: 5px 12px 5px 6px;\n      border-radius: 30px;\n      border: 1px solid var(--border-neon);\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n    }\n\n    .channel-avatar {\n      width: 32px;\n      height: 32px;\n      border-radius: 50%;\n      background: linear-gradient(135deg, var(--neon-magenta), var(--neon-cyan));\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 700;\n      font-size: 11px;\n      color: #fff;\n      letter-spacing: -0.5px;\n      box-shadow: 0 0 10px var(--neon-magenta-glow);\n    }\n\n    .channel-meta {\n      display: flex;\n      flex-direction: column;\n      line-height: 1.1;\n    }\n\n    .channel-title {\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 12px;\n      font-weight: 700;\n      color: #fff;\n      letter-spacing: 0.3px;\n    }\n\n    .channel-stats {\n      font-size: 10px;\n      color: var(--text-muted);\n      display: flex;\n      align-items: center;\n      gap: 4px;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .live-badge {\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      background: rgba(229, 30, 226, 0.2);\n      border: 1px solid var(--neon-magenta);\n      color: #fff;\n      font-size: 10px;\n      font-weight: 700;\n      padding: 4px 9px;\n      border-radius: 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      box-shadow: 0 0 12px var(--neon-magenta-glow);\n      animation: pulse-live 1.8s infinite ease-in-out;\n    }\n\n    .pulse-dot {\n      width: 7px;\n      height: 7px;\n      background: #ff0055;\n      border-radius: 50%;\n      box-shadow: 0 0 8px #ff0055;\n    }\n\n    @keyframes pulse-live {\n      0%, 100% { transform: scale(1); opacity: 1; }\n      50% { transform: scale(1.04); opacity: 0.85; box-shadow: 0 0 18px var(--neon-magenta); }\n    }\n\n    .spectator-chip {\n      background: rgba(0, 0, 0, 0.55);\n      backdrop-filter: blur(8px);\n      border: 1px solid var(--border-color);\n      font-size: 11px;\n      font-weight: 600;\n      padding: 4px 8px;\n      border-radius: 20px;\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      color: #eaeaea;\n    }\n\n    .icon-btn {\n      width: 30px;\n      height: 30px;\n      border-radius: 50%;\n      background: rgba(0,0,0,0.55);\n      border: 1px solid var(--border-color);\n      color: white;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: all 0.2s;\n    }\n    .icon-btn:active {\n      transform: scale(0.9);\n    }\n\n    /* Barra Lateral de Acciones (Derecha) */\n    .stream-side-actions {\n      position: absolute;\n      right: 14px;\n      bottom: 180px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 16px;\n      z-index: 20;\n    }\n\n    .side-action-btn {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 3px;\n      background: transparent;\n      border: none;\n      cursor: pointer;\n      color: #fff;\n    }\n\n    .side-icon-circle {\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      background: rgba(18, 18, 22, 0.7);\n      backdrop-filter: blur(10px);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 19px;\n      box-shadow: 0 4px 15px rgba(0,0,0,0.4);\n      transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    }\n    .side-action-btn:active .side-icon-circle {\n      transform: scale(1.22);\n    }\n    .side-label {\n      font-size: 10px;\n      font-weight: 600;\n      color: #eaeaea;\n      text-shadow: 0 1px 4px rgba(0,0,0,0.8);\n    }\n    .like-btn .side-icon-circle {\n      border-color: rgba(229, 30, 226, 0.4);\n      color: #ff3282;\n    }\n\n    /* Floating Hearts Container */\n    .hearts-box {\n      position: absolute;\n      bottom: 120px;\n      right: 20px;\n      width: 70px;\n      height: 300px;\n      pointer-events: none;\n      z-index: 100;\n      overflow: visible;\n    }\n\n    .flying-heart {\n      position: absolute;\n      bottom: 0;\n      right: 10px;\n      font-size: 24px;\n      user-select: none;\n      animation: floatHeart 1.8s forwards cubic-bezier(0.22, 1, 0.36, 1);\n    }\n\n    @keyframes floatHeart {\n      0% {\n        transform: translateY(0) scale(0.6) rotate(0deg);\n        opacity: 0.95;\n      }\n      50% {\n        transform: translateY(-140px) scale(1.25) rotate(15deg) translateX(-15px);\n        opacity: 0.85;\n      }\n      100% {\n        transform: translateY(-280px) scale(0.8) rotate(-20deg) translateX(20px);\n        opacity: 0;\n      }\n    }\n\n    /* Middle/Lower Section: Chat + Product Card */\n    .bottom-section {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      position: relative;\n      z-index: 15;\n    }\n\n    /* Chat Box */\n    .chat-container {\n      height: 170px;\n      max-height: 170px;\n      overflow-y: auto;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n      padding-right: 50px;\n      mask-image: linear-gradient(to bottom, transparent 0%, black 22%);\n      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 22%);\n      scrollbar-width: none;\n    }\n    .chat-container::-webkit-scrollbar {\n      display: none;\n    }\n\n    .chat-bubble {\n      background: rgba(18, 18, 22, 0.65);\n      backdrop-filter: blur(10px);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      padding: 6px 11px;\n      border-radius: 14px;\n      font-size: 11.5px;\n      line-height: 1.35;\n      color: #fff;\n      width: fit-content;\n      max-width: 95%;\n      animation: slideInChat 0.3s ease-out;\n    }\n\n    @keyframes slideInChat {\n      from { opacity: 0; transform: translateY(10px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    .chat-bubble .user {\n      font-weight: 700;\n      color: var(--neon-cyan);\n      margin-right: 4px;\n    }\n\n    .chat-bubble.bot-bubble {\n      background: linear-gradient(135deg, rgba(229, 30, 226, 0.22), rgba(6, 147, 227, 0.22));\n      border: 1px solid var(--neon-magenta);\n      box-shadow: 0 0 15px rgba(229, 30, 226, 0.25);\n    }\n    .chat-bubble.bot-bubble .user {\n      color: var(--neon-magenta);\n      display: inline-flex;\n      align-items: center;\n      gap: 3px;\n    }\n\n    /* Tarjeta de Producto Flotante */\n    .product-live-card {\n      background: rgba(18, 18, 22, 0.92);\n      backdrop-filter: blur(16px);\n      border: 1px solid var(--border-neon);\n      border-radius: 18px;\n      padding: 10px 12px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 16px var(--neon-magenta-glow);\n      position: relative;\n      overflow: hidden;\n      transition: transform 0.2s;\n    }\n\n    .product-live-card::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: -100%;\n      width: 50%;\n      height: 100%;\n      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);\n      transform: skewX(-25deg);\n      animation: cardShine 4s infinite;\n    }\n\n    @keyframes cardShine {\n      0%, 70% { left: -100%; }\n      100% { left: 160%; }\n    }\n\n    .product-thumb {\n      width: 60px;\n      height: 60px;\n      border-radius: 12px;\n      object-fit: cover;\n      background: #252530;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      flex-shrink: 0;\n    }\n\n    .product-info {\n      flex: 1;\n      min-width: 0;\n    }\n\n    .product-tag {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      background: rgba(229, 30, 226, 0.2);\n      color: #ff52eb;\n      font-size: 9.5px;\n      font-weight: 700;\n      padding: 2px 6px;\n      border-radius: 6px;\n      margin-bottom: 3px;\n    }\n\n    .product-title {\n      font-size: 13px;\n      font-weight: 700;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      color: #fff;\n    }\n\n    .product-pricing {\n      display: flex;\n      align-items: baseline;\n      gap: 6px;\n      margin-top: 2px;\n    }\n\n    .current-price {\n      font-size: 15px;\n      font-weight: 800;\n      color: var(--neon-cyan);\n      font-family: 'Space Grotesk', sans-serif;\n    }\n\n    .old-price {\n      font-size: 11px;\n      color: var(--text-muted);\n      text-decoration: line-through;\n    }\n\n    .stock-chip {\n      font-size: 10px;\n      color: #ff7675;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 3px;\n    }\n\n    .btn-buy-pulse {\n      background: linear-gradient(135deg, var(--neon-magenta), #b800b5);\n      color: #fff;\n      border: none;\n      padding: 9px 12px;\n      border-radius: 12px;\n      font-weight: 700;\n      font-size: 11px;\n      cursor: pointer;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      box-shadow: 0 4px 15px var(--neon-magenta-glow);\n      transition: transform 0.15s, box-shadow 0.15s;\n      white-space: nowrap;\n      flex-shrink: 0;\n    }\n    .btn-buy-pulse:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 6px 20px rgba(229, 30, 226, 0.6);\n    }\n    .btn-buy-pulse:active {\n      transform: scale(0.96);\n    }\n\n    /* Barra Inferior de Entrada (Input + Acciones) */\n    .chat-input-bar {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      width: 100%;\n    }\n\n    .input-wrapper {\n      flex: 1;\n      position: relative;\n      display: flex;\n      align-items: center;\n    }\n\n    .input-field {\n      width: 100%;\n      background: rgba(18, 18, 22, 0.75);\n      backdrop-filter: blur(14px);\n      border: 1px solid var(--border-color);\n      border-radius: 25px;\n      padding: 10px 42px 10px 16px;\n      color: #fff;\n      font-size: 12px;\n      font-family: inherit;\n      outline: none;\n      transition: border-color 0.2s, box-shadow 0.2s;\n    }\n    .input-field:focus {\n      border-color: var(--neon-cyan);\n      box-shadow: 0 0 12px var(--neon-cyan-glow);\n    }\n    .input-field::placeholder {\n      color: #7a7a88;\n    }\n\n    .send-btn {\n      position: absolute;\n      right: 6px;\n      width: 30px;\n      height: 30px;\n      border-radius: 50%;\n      background: var(--neon-cyan);\n      border: none;\n      color: #000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-weight: bold;\n      transition: transform 0.15s;\n    }\n    .send-btn:active {\n      transform: scale(0.85);\n    }\n\n    .share-btn-round {\n      width: 38px;\n      height: 38px;\n      border-radius: 50%;\n      background: rgba(18, 18, 22, 0.75);\n      backdrop-filter: blur(10px);\n      border: 1px solid var(--border-color);\n      color: #fff;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      flex-shrink: 0;\n    }\n\n    /* Drawer Checkout 1-Click */\n    .checkout-drawer {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      width: 100%;\n      background: #111116;\n      border-top: 2px solid var(--neon-magenta);\n      border-radius: 26px 26px 0 0;\n      z-index: 60;\n      box-shadow: 0 -15px 40px rgba(0, 0, 0, 0.9), 0 0 25px var(--neon-magenta-glow);\n      transform: translateY(105%);\n      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n      padding: 16px 20px 24px;\n      pointer-events: auto;\n      max-height: 85%;\n      overflow-y: auto;\n    }\n    .checkout-drawer.active {\n      transform: translateY(0%);\n    }\n\n    .drawer-handle {\n      width: 44px;\n      height: 5px;\n      background: rgba(255, 255, 255, 0.25);\n      border-radius: 10px;\n      margin: 0 auto 12px;\n      cursor: pointer;\n    }\n\n    .drawer-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 14px;\n    }\n    .drawer-header h3 {\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 17px;\n      color: #fff;\n    }\n    .drawer-header p {\n      font-size: 11px;\n      color: var(--neon-cyan);\n    }\n    .btn-close-drawer {\n      background: rgba(255,255,255,0.1);\n      border: none;\n      color: #fff;\n      width: 26px;\n      height: 26px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n    }\n\n    /* Variantes */\n    .selection-label {\n      font-size: 11px;\n      font-weight: 600;\n      text-transform: uppercase;\n      color: var(--text-muted);\n      letter-spacing: 0.5px;\n      margin: 10px 0 6px;\n    }\n    .variant-group {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 8px;\n    }\n    .variant-pill {\n      padding: 6px 14px;\n      border-radius: 10px;\n      font-size: 12px;\n      font-weight: 600;\n      background: #1a1a22;\n      border: 1px solid var(--border-color);\n      color: #d1d1d6;\n      cursor: pointer;\n      transition: all 0.2s;\n    }\n    .variant-pill.active {\n      background: rgba(6, 147, 227, 0.15);\n      border-color: var(--neon-cyan);\n      color: #fff;\n      box-shadow: 0 0 10px var(--neon-cyan-glow);\n    }\n\n    /* Inputs del Checkout */\n    .form-group {\n      display: flex;\n      flex-direction: column;\n      gap: 7px;\n      margin-top: 10px;\n    }\n    .form-input {\n      width: 100%;\n      background: #181820;\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      border-radius: 10px;\n      padding: 10px 12px;\n      color: #fff;\n      font-size: 12px;\n      outline: none;\n      font-family: inherit;\n    }\n    .form-input:focus {\n      border-color: var(--neon-magenta);\n    }\n\n    .payment-select {\n      background: #181820;\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      border-radius: 10px;\n      padding: 10px 12px;\n      color: #fff;\n      font-size: 12px;\n      outline: none;\n      cursor: pointer;\n    }\n\n    .btn-confirm-order {\n      width: 100%;\n      margin-top: 16px;\n      padding: 13px;\n      border-radius: 12px;\n      background: linear-gradient(135deg, var(--neon-magenta) 0%, var(--neon-cyan) 100%);\n      color: #fff;\n      border: none;\n      font-weight: 700;\n      font-size: 13px;\n      cursor: pointer;\n      letter-spacing: 0.5px;\n      box-shadow: 0 4px 20px rgba(229, 30, 226, 0.45);\n      transition: transform 0.15s;\n    }\n    .btn-confirm-order:active {\n      transform: scale(0.97);\n    }\n\n    /* Notificación de éxito */\n    .toast-notification {\n      position: absolute;\n      top: 50px;\n      left: 50%;\n      transform: translateX(-50%) translateY(-20px);\n      background: #0f1c15;\n      border: 1px solid var(--success);\n      color: #fff;\n      padding: 10px 16px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      box-shadow: 0 10px 25px rgba(0, 230, 118, 0.3);\n      opacity: 0;\n      pointer-events: none;\n      z-index: 100;\n      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    }\n    .toast-notification.active {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n\n    .whatsapp-badge-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      background: #25d366;\n      color: #000;\n      font-weight: 700;\n      font-size: 10px;\n      padding: 3px 7px;\n      border-radius: 10px;\n      text-decoration: none;\n      margin-top: 5px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Mockup Frame -->\n  <div class=\"device-wrapper\" id=\"deviceScreen\">\n    \n    <!-- Dynamic Island / Notch -->\n    <div class=\"device-notch\">\n      <div class=\"device-camera\"></div>\n    </div>\n\n    <!-- Toast Alerta de Compra Exitosa -->\n    <div class=\"toast-notification\" id=\"orderToast\">\n      <span>✅</span>\n      <span>¡Pedido confirmado! Te contactaremos al WhatsApp.</span>\n    </div>\n\n    <!-- Video / Stream Viewport -->\n    <div class=\"video-viewport\">\n      <video \n        id=\"liveVideo\" \n        class=\"video-stream\" \n        autoplay \n        loop \n        muted \n        playsinline \n        webkit-playsinline\n        poster=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='700' fill='%23121216'><rect width='400' height='700'/><text x='50%25' y='50%25' fill='%23E51EE2' font-family='sans-serif' font-size='20' text-anchor='middle'>CONECTANDO LIVE STREAM...</text></svg>\"\n      >\n        <!-- Video vertical de e-commerce / showroom con CDN público y liviano -->\n        <source src=\"https://assets.mixkit.co/videos/preview/mixkit-fashion-model-in-neon-light-40431-large.mp4\" type=\"video/mp4\" />\n      </video>\n\n      <!-- Fallback canvas de partículas en caso de bloqueo o offline -->\n      <canvas id=\"fallbackCanvas\"></canvas>\n      <div class=\"video-overlay-gradient\"></div>\n    </div>\n\n    <!-- Contenedor Corazones Voladores -->\n    <div class=\"hearts-box\" id=\"heartsContainer\"></div>\n\n    <!-- UI Layer -->\n    <div class=\"ui-layer\">\n      \n      <!-- HEADER -->\n      <div class=\"stream-header ui-interactive\">\n        <div class=\"channel-info\">\n          <div class=\"channel-avatar\">LEPS</div>\n          <div class=\"channel-meta\">\n            <span class=\"channel-title\">LEPS Digital Store</span>\n            <span class=\"channel-stats\">⚡ Oficial</span>\n          </div>\n        </div>\n\n        <div class=\"header-actions\">\n          <div class=\"live-badge\">\n            <div class=\"pulse-dot\"></div>\n            <span>EN VIVO</span>\n          </div>\n\n          <div class=\"spectator-chip\">\n            <span>👁️</span>\n            <span id=\"viewerCounter\">214</span>\n          </div>\n\n          <button class=\"icon-btn\" id=\"btnMuteToggle\" title=\"Sonido\">\n            <span id=\"muteIcon\">🔇</span>\n          </button>\n        </div>\n      </div>\n\n      <!-- ACCIONES LATERALES DERECHA -->\n      <div class=\"stream-side-actions ui-interactive\">\n        <button class=\"side-action-btn like-btn\" id=\"btnLikeStream\">\n          <div class=\"side-icon-circle\">\n            ❤️\n          </div>\n          <span class=\"side-label\" id=\"likesCountLabel\">4.8k</span>\n        </button>\n\n        <button class=\"side-action-btn\" id=\"btnQuickShare\">\n          <div class=\"side-icon-circle\">\n            🚀\n          </div>\n          <span class=\"side-label\">Compartir</span>\n        </button>\n\n        <button class=\"side-action-btn\" id=\"btnWhatsAppDirect\" onclick=\"window.open('https://wa.me/573197036711?text=Hola%20LEPS,%20estoy%20en%20el%20Live%20Shopping%20y%20tengo%20una%20consulta', '_blank')\">\n          <div class=\"side-icon-circle\" style=\"border-color: #25d366;\">\n            💬\n          </div>\n          <span class=\"side-label\">Asesor</span>\n        </button>\n      </div>\n\n      <!-- SECCIÓN INFERIOR (CHAT + PRODUCTO + INPUT) -->\n      <div class=\"bottom-section ui-interactive\">\n        \n        <!-- Live Chat Box -->\n        <div class=\"chat-container\" id=\"chatScroll\">\n          <div class=\"chat-bubble\">\n            <span class=\"user\">Moderador:</span> Bienvenidos al Live Shopping de LEPS Software. ¡Aprovechen el 30% OFF!\n          </div>\n        </div>\n\n        <!-- Producto Destacado en Tiempo Real -->\n        <div class=\"product-live-card\">\n          <img \n            class=\"product-thumb\" \n            src=\"https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=180&q=80\" \n            alt=\"Solución LEPS\" \n          />\n          <div class=\"product-info\">\n            <div class=\"product-tag\">🔥 OFERTA EN VIVO</div>\n            <div class=\"product-title\">Faja Reloj de Arena / Tech LEPS</div>\n            <div class=\"product-pricing\">\n              <span class=\"current-price\">$149.000 COP</span>\n              <span class=\"old-price\">$210.000</span>\n            </div>\n            <div class=\"stock-chip\">\n              <span>⏳</span> <span id=\"stockQty\">¡Solo quedan 4 unidades!</span>\n            </div>\n          </div>\n          <button class=\"btn-buy-pulse\" id=\"btnOpenCheckout\">\n            <span>COMPRAR</span>\n            <span style=\"font-size: 8.5px; opacity: 0.9;\">1-CLICK</span>\n          </button>\n        </div>\n\n        <!-- Barra de Input del Chat -->\n        <div class=\"chat-input-bar\">\n          <div class=\"input-wrapper\">\n            <input \n              type=\"text\" \n              id=\"userChatInput\" \n              class=\"input-field\" \n              placeholder=\"Pregúntale a LepsBot (envíos, tallas...)\" \n              maxlength=\"80\"\n            />\n            <button class=\"send-btn\" id=\"btnSendChat\">➤</button>\n          </div>\n          <button class=\"share-btn-round\" id=\"btnHeartTap\" title=\"Dar Amor\">💖</button>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- MODAL DRAWER CHECKOUT 1-CLICK -->\n    <div class=\"checkout-drawer\" id=\"checkoutDrawer\">\n      <div class=\"drawer-handle\" id=\"closeHandle\"></div>\n      \n      <div class=\"drawer-header\">\n        <div>\n          <h3>Finalizar Pedido Rápido</h3>\n          <p>Envío Express Gratis a toda Colombia</p>\n        </div>\n        <button class=\"btn-close-drawer\" id=\"btnCloseDrawer\">✕</button>\n      </div>\n\n      <div class=\"selection-label\">Selecciona tu Talla:</div>\n      <div class=\"variant-group\" id=\"sizeGroup\">\n        <div class=\"variant-pill active\" data-val=\"S\">S (Small)</div>\n        <div class=\"variant-pill\" data-val=\"M\">M (Medium)</div>\n        <div class=\"variant-pill\" data-val=\"L\">L (Large)</div>\n      </div>\n\n      <div class=\"selection-label\">Selecciona el Color:</div>\n      <div class=\"variant-group\" id=\"colorGroup\">\n        <div class=\"variant-pill active\" data-val=\"Negro Cyber\">Negro Cyber</div>\n        <div class=\"variant-pill\" data-val=\"Beige Nude\">Beige Nude</div>\n      </div>\n\n      <form id=\"quickCheckoutForm\" class=\"form-group\" onsubmit=\"return false;\">\n        <input type=\"text\" class=\"form-input\" id=\"orderName\" placeholder=\"Nombre Completo\" required />\n        <input type=\"tel\" class=\"form-input\" id=\"orderPhone\" placeholder=\"WhatsApp o Teléfono (ej. 3197036711)\" required />\n        <input type=\"text\" class=\"form-input\" id=\"orderAddress\" placeholder=\"Ciudad y Dirección de Envío\" required />\n        \n        <div class=\"selection-label\" style=\"margin-top: 4px;\">Método de Pago:</div>\n        <select class=\"payment-select\" id=\"paymentMethod\">\n          <option value=\"contraentrega\">📦 Pago Contra Entrega (Pagas al recibir)</option>\n          <option value=\"nequi\">🟣 Nequi / Daviplata / PSE</option>\n          <option value=\"tarjeta\">💳 Tarjeta Débito / Crédito</option>\n        </select>\n\n        <button type=\"submit\" class=\"btn-confirm-order\" id=\"btnSubmitOrder\">\n          CONFIRMAR PEDIDO • $149.000 COP\n        </button>\n      </form>\n    </div>\n\n  </div>\n\n  <script>\n    /* ==========================================================================\n       LEPS SOFTWARE SOLUTIONS - LIVE SHOPPING ARCHITECTURE ENGINE\n       ========================================================================== */\n    \n    // 1. ESTADO GLOBAL DEL SIMULADOR\n    const state = {\n      viewers: 214,\n      likes: 4820,\n      stock: 4,\n      selectedSize: 'S',\n      selectedColor: 'Negro Cyber',\n      isMuted: true,\n      autoMessagesQueue: [\n        { user: \"Camila R.\", text: \"¿Tienen envíos contraentrega a Medellín?\" },\n        { user: \"Juan Pablo\", text: \"¡Acabo de pedir la mía! Ojalá llegue rápido 🚀\" },\n        { user: \"Valentina Gómez\", text: \"¿Para cintura de 68cm qué talla recomiendan?\" },\n        { user: \"Esteban V.\", text: \"Brutal la plataforma LEPS, qué fluidez 🔥\" },\n        { user: \"Carolina M.\", text: \"¿Viene con garantía por si no me queda?\" },\n        { user: \"Andrés B.\", text: \"Pagué por Nequi super fácil.\" }\n      ]\n    };\n\n    // Elementos DOM principales\n    const viewerCounterEl = document.getElementById('viewerCounter');\n    const likesCountLabelEl = document.getElementById('likesCountLabel');\n    const heartsContainerEl = document.getElementById('heartsContainer');\n    const chatScrollEl = document.getElementById('chatScroll');\n    const userChatInputEl = document.getElementById('userChatInput');\n    const btnSendChatEl = document.getElementById('btnSendChat');\n    const btnLikeStreamEl = document.getElementById('btnLikeStream');\n    const btnHeartTapEl = document.getElementById('btnHeartTap');\n    const liveVideoEl = document.getElementById('liveVideo');\n    const btnMuteToggleEl = document.getElementById('btnMuteToggle');\n    const muteIconEl = document.getElementById('muteIcon');\n    const checkoutDrawerEl = document.getElementById('checkoutDrawer');\n    const btnOpenCheckoutEl = document.getElementById('btnOpenCheckout');\n    const btnCloseDrawerEl = document.getElementById('btnCloseDrawer');\n    const closeHandleEl = document.getElementById('closeHandle');\n    const quickCheckoutFormEl = document.getElementById('quickCheckoutForm');\n    const orderToastEl = document.getElementById('orderToast');\n    const stockQtyEl = document.getElementById('stockQty');\n\n    // 2. VIDEO FALLBACK ENGINE (Simulación Canvas si el video tiene problemas)\n    function setupVideoFallback() {\n      const canvas = document.getElementById('fallbackCanvas');\n      const ctx = canvas.getContext('2d');\n      \n      function resizeCanvas() {\n        canvas.width = canvas.parentElement.clientWidth;\n        canvas.height = canvas.parentElement.clientHeight;\n      }\n      resizeCanvas();\n      window.addEventListener('resize', resizeCanvas);\n\n      let particles = Array.from({ length: 45 }, () => ({\n        x: Math.random() * canvas.width,\n        y: Math.random() * canvas.height,\n        radius: Math.random() * 2 + 1,\n        dx: (Math.random() - 0.5) * 0.8,\n        dy: (Math.random() - 0.5) * 0.8,\n        color: Math.random() > 0.5 ? '#E51EE2' : '#0693E3'\n      }));\n\n      function animateCanvas() {\n        ctx.fillStyle = '#08080f';\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\n        \n        // Efecto visual cibernético de showroom\n        ctx.strokeStyle = 'rgba(6, 147, 227, 0.15)';\n        ctx.lineWidth = 1;\n        for (let y = 0; y < canvas.height; y += 40) {\n          ctx.beginPath();\n          ctx.moveTo(0, y);\n          ctx.lineTo(canvas.width, y);\n          ctx.stroke();\n        }\n\n        particles.forEach(p => {\n          p.x += p.dx;\n          p.y += p.dy;\n          if (p.x < 0 || p.x > canvas.width) p.dx *= -1;\n          if (p.y < 0 || p.y > canvas.height) p.dy *= -1;\n\n          ctx.beginPath();\n          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n          ctx.fillStyle = p.color;\n          ctx.fill();\n        });\n\n        requestAnimationFrame(animateCanvas);\n      }\n\n      liveVideoEl.addEventListener('error', () => {\n        canvas.style.display = 'block';\n        animateCanvas();\n      });\n    }\n    setupVideoFallback();\n\n    // 3. FLUIDEZ Y SIMULACIÓN EN VIVO (Fluctuación de Espectadores)\n    setInterval(() => {\n      // Fluctúa de manera orgánica entre 185 y 240\n      const delta = Math.floor(Math.random() * 7) - 3;\n      state.viewers = Math.max(185, Math.min(240, state.viewers + delta));\n      viewerCounterEl.textContent = state.viewers;\n    }, 3500);\n\n    // 4. CORAZONES FLOTANTES Y SISTEMA DE LIKES\n    function spawnHeart() {\n      const heartIcons = ['❤️', '💖', '🔥', '✨', '💜'];\n      const heart = document.createElement('div');\n      heart.className = 'flying-heart';\n      heart.textContent = heartIcons[Math.floor(Math.random() * heartIcons.length)];\n      \n      // Posición aleatoria ligera\n      const randomX = Math.random() * 40 - 20;\n      heart.style.transform = `translateX(${randomX}px)`;\n      heartsContainerEl.appendChild(heart);\n\n      state.likes++;\n      likesCountLabelEl.textContent = (state.likes / 1000).toFixed(1) + 'k';\n\n      setTimeout(() => {\n        heart.remove();\n      }, 1800);\n    }\n\n    btnLikeStreamEl.addEventListener('click', () => {\n      for (let i = 0; i < 3; i++) {\n        setTimeout(spawnHeart, i * 90);\n      }\n    });\n    btnHeartTapEl.addEventListener('click', spawnHeart);\n\n    // 5. CHAT DINÁMICO & AGENTE IA LEPSBOT\n    function appendChatMessage(user, text, isBot = false) {\n      const bubble = document.createElement('div');\n      bubble.className = `chat-bubble ${isBot ? 'bot-bubble' : ''}`;\n      \n      if (isBot) {\n        bubble.innerHTML = `<span class=\"user\">🤖 LepsBot:</span> ${text}`;\n      } else {\n        bubble.innerHTML = `<span class=\"user\">${user}:</span> ${text}`;\n      }\n\n      chatScrollEl.appendChild(bubble);\n      chatScrollEl.scrollTo({ top: chatScrollEl.scrollHeight, behavior: 'smooth' });\n    }\n\n    // Ciclo de mensajes automáticos que simulan audiencia activa\n    let msgIndex = 0;\n    setInterval(() => {\n      if (msgIndex < state.autoMessagesQueue.length) {\n        const msg = state.autoMessagesQueue[msgIndex];\n        appendChatMessage(msg.user, msg.text);\n        msgIndex = (msgIndex + 1) % state.autoMessagesQueue.length;\n      }\n    }, 5500);\n\n    // Motor Lógico de Inteligencia Artificial (LepsBot)\n    function processAiAgentResponse(userQuery) {\n      const query = userQuery.toLowerCase();\n      let responseText = \"\";\n      let showWhatsAppCta = false;\n\n      if (query.includes('envio') || query.includes('envíos') || query.includes('ciudad') || query.includes('medellin') || query.includes('bogota') || query.includes('cali')) {\n        responseText = \"¡Sí! Tenemos Envíos Express Gratis a toda Colombia con opción de Pago Contra Entrega (pagas en tu puerta). 📦💨\";\n      } else if (query.includes('talla') || query.includes('medida') || query.includes('cintura') || query.includes('grande') || query.includes('pequeñ')) {\n        responseText = \"Para la Faja Reloj de Arena recomendamos: Talla S (Cintura 60-70cm), M (71-82cm) y L (83-95cm). Si tienes dudas intermedias, elige la talla superior.\";\n      } else if (query.includes('pago') || query.includes('pagar') || query.includes('nequi') || query.includes('tarjeta') || query.includes('contraentrega')) {\n        responseText = \"Aceptamos Pago Contra Entrega en efectivo, Nequi, Daviplata, Tarjetas Débito y Crédito con checkout seguro 100% cifrado.\";\n      } else if (query.includes('garantia') || query.includes('garantía') || query.includes('cambio') || query.includes('devolucion')) {\n        responseText = \"Cuentas con 30 días de garantía total por confección o cambio de talla directo con nosotros. ¡Tu compra está 100% asegurada!\";\n      } else if (query.includes('precio') || query.includes('costo') || query.includes('vale') || query.includes('descuento')) {\n        responseText = \"¡Hoy durante este LIVE está en solo $149.000 COP (antes $210.000)! Aprovecha antes de que se agote el stock.\";\n      } else {\n        responseText = \"¡Excelente pregunta! Nuestro equipo de ingenieros y asesores comerciales te pueden asesorar en vivo 1 a 1 por WhatsApp.\";\n        showWhatsAppCta = true;\n      }\n\n      setTimeout(() => {\n        appendChatMessage(\"LepsBot\", responseText, true);\n        if (showWhatsAppCta) {\n          setTimeout(() => {\n            const ctaBubble = document.createElement('div');\n            ctaBubble.className = 'chat-bubble bot-bubble';\n            ctaBubble.innerHTML = `<span class=\"user\">🤖 LepsBot:</span> Haz clic para chatear directo: <br><a class=\"whatsapp-badge-pill\" href=\"https://wa.me/573197036711?text=Hola%20LEPS,%20tengo%20una%20consulta%20especial%20del%20Live\" target=\"_blank\">🟢 Abrir WhatsApp (+57 319 703 6711)</a>`;\n            chatScrollEl.appendChild(ctaBubble);\n            chatScrollEl.scrollTo({ top: chatScrollEl.scrollHeight, behavior: 'smooth' });\n          }, 600);\n        }\n      }, 1300);\n    }\n\n    function handleUserSendMessage() {\n      const text = userChatInputEl.value.trim();\n      if (!text) return;\n      appendChatMessage(\"Tú\", text);\n      userChatInputEl.value = \"\";\n      processAiAgentResponse(text);\n    }\n\n    btnSendChatEl.addEventListener('click', handleUserSendMessage);\n    userChatInputEl.addEventListener('keypress', (e) => {\n      if (e.key === 'Enter') handleUserSendMessage();\n    });\n\n    // 6. TOGGLE DE SONIDO (MUTE)\n    btnMuteToggleEl.addEventListener('click', () => {\n      state.isMuted = !state.isMuted;\n      liveVideoEl.muted = state.isMuted;\n      muteIconEl.textContent = state.isMuted ? '🔇' : '🔊';\n    });\n\n    // 7. BOTÓN COMPARTIR\n    document.getElementById('btnQuickShare').addEventListener('click', () => {\n      if (navigator.share) {\n        navigator.share({\n          title: 'Live Shopping LEPS Software',\n          text: '¡Conéctate al Live Shopping con descuentos exclusivos en tiempo real!',\n          url: window.location.href\n        }).catch(() => {});\n      } else {\n        navigator.clipboard.writeText(window.location.href);\n        appendChatMessage(\"Sistema\", \"Enlace de transmisión copiado al portapapeles.\");\n      }\n    });\n\n    // 8. FLUJO DE CHECKOUT 1-CLICK (MODAL DRAWER)\n    function openCheckout() {\n      checkoutDrawerEl.classList.add('active');\n    }\n\n    function closeCheckout() {\n      checkoutDrawerEl.classList.remove('active');\n    }\n\n    btnOpenCheckoutEl.addEventListener('click', openCheckout);\n    btnCloseDrawerEl.addEventListener('click', closeCheckout);\n    closeHandleEl.addEventListener('click', closeCheckout);\n\n    // Selector de Variantes (Talla y Color)\n    document.querySelectorAll('#sizeGroup .variant-pill').forEach(pill => {\n      pill.addEventListener('click', function() {\n        document.querySelectorAll('#sizeGroup .variant-pill').forEach(p => p.classList.remove('active'));\n        this.classList.add('active');\n        state.selectedSize = this.dataset.val;\n      });\n    });\n\n    document.querySelectorAll('#colorGroup .variant-pill').forEach(pill => {\n      pill.addEventListener('click', function() {\n        document.querySelectorAll('#colorGroup .variant-pill').forEach(p => p.classList.remove('active'));\n        this.classList.add('active');\n        state.selectedColor = this.dataset.val;\n      });\n    });\n\n    // Envío del Formulario de Compra\n    quickCheckoutFormEl.addEventListener('submit', (e) => {\n      e.preventDefault();\n      const name = document.getElementById('orderName').value.trim();\n      const phone = document.getElementById('orderPhone').value.trim();\n      const address = document.getElementById('orderAddress').value.trim();\n      const method = document.getElementById('paymentMethod').value;\n\n      if (!name || !phone || !address) return;\n\n      // Reducción de urgencia de stock\n      if (state.stock > 1) {\n        state.stock--;\n        stockQtyEl.textContent = `¡Solo quedan ${state.stock} unidades!`;\n      } else {\n        stockQtyEl.textContent = `¡ÚLTIMA UNIDAD DISPONIBLE!`;\n      }\n\n      closeCheckout();\n      quickCheckoutFormEl.reset();\n\n      // Mostrar Toast Flotante\n      orderToastEl.classList.add('active');\n      setTimeout(() => {\n        orderToastEl.classList.remove('active');\n      }, 4500);\n\n      // Disparar mensaje de prueba social en el chat\n      setTimeout(() => {\n        appendChatMessage(\"Sistema LEPS\", `🎉 ${name.split(' ')[0]} acaba de comprar (Talla ${state.selectedSize} / ${state.selectedColor})`);\n        for (let i = 0; i < 5; i++) {\n          setTimeout(spawnHeart, i * 80);\n        }\n      }, 800);\n    });\n  </script>\n</body>\n</html>"
}